# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=policies

# AI Provider API Keys (at least one required)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Database (direct Postgres access, optional)
DB_URL=your_postgres_connection_string

# Models
EMBEDDING_MODEL=text-embedding-3-large
CHAT_MODEL=gpt-4o-mini

# Auth & Notification Email
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
# Optional; if not set, defaults to <NEXT_PUBLIC_APP_URL>/api/auth/sso/callback
AZURE_REDIRECT_URI=your_azure_redirect_uri
GRAPH_SENDER_UPN=sender@yourcompany.com
IT_SERVICEDESK_EMAIL=itservicedesk@yourcompany.com
TRAVEL_DESK_EMAIL=traveldesk@yourcompany.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
